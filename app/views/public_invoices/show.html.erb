<% content_for :title, "Invoice #{@invoice.number} — #{@business}" %>
<main class="commerce-invoice">
  <header class="commerce-invoice__header">
    <div>
      <% if @logo_url.present? %><img src="<%= @logo_url %>" alt="<%= @business %>" class="commerce-invoice__logo"><% end %>
      <p class="commerce-invoice__eyebrow"><%= @business %></p>
      <h1 class="commerce-invoice__title">Invoice <%= @invoice.number %></h1>
      <p class="commerce-invoice__dates">
        <% if @invoice.issued_on %>Issued <%= @invoice.issued_on.to_fs(:long) %><% end %>
        <% if @invoice.due_on %> · Due <%= @invoice.due_on.to_fs(:long) %><% end %>
      </p>
    </div>
    <span class="<%= class_names("badge", "badge--success": @invoice.paid?, "badge--warning": !@invoice.paid? && !@invoice.void?, "commerce-invoice__void": @invoice.void?) %>"><%= @invoice.paid? ? "Paid" : @invoice.void? ? "Void" : "Due" %></span>
  </header>

  <div class="commerce-invoice__parties">
    <div>
      <p class="commerce-invoice__eyebrow">Billed to</p>
      <p class="commerce-invoice__party"><%= @invoice.customer_name %></p>
      <% if @invoice.company.present? %><p><%= @invoice.company %></p><% end %>
      <% if @invoice.billing_address.present? %><p class="commerce-invoice__address"><%= @invoice.billing_address %></p><% end %>
      <% if @invoice.customer_email.present? %><p class="commerce-invoice__muted"><%= @invoice.customer_email %></p><% end %>
      <% if @invoice.customer_phone.present? %><p class="commerce-invoice__muted"><%= @invoice.customer_phone %></p><% end %>
    </div>
    <div>
      <p class="commerce-invoice__eyebrow">From</p>
      <p class="commerce-invoice__party"><%= @business %></p>
      <% if @settings["business_address"].present? %><p class="commerce-invoice__address commerce-invoice__muted"><%= @settings["business_address"] %></p><% end %>
      <% if @settings["reply_to"].present? %><p class="commerce-invoice__muted"><%= @settings["reply_to"] %></p><% end %>
      <% if @settings["business_phone"].present? %><p class="commerce-invoice__muted"><%= @settings["business_phone"] %></p><% end %>
    </div>
  </div>

  <div class="commerce-invoice__lines">
    <table class="commerce-invoice__table">
      <thead>
        <tr>
          <th>Description</th>
          <th class="commerce-invoice__num">Qty</th>
          <th class="commerce-invoice__num">Unit</th>
          <th class="commerce-invoice__num">Amount</th>
        </tr>
      </thead>
      <tbody>
        <% @invoice.line_items.each_with_index do |line, index| %>
          <%# herb:key index %>
          <tr>
            <td>
              <span class="commerce-invoice__description"><%= line["description"] %></span>
              <% if line["sku"].present? %><span class="commerce-invoice__sku">SKU <%= line["sku"] %></span><% end %>
            </td>
            <td class="commerce-invoice__num"><%= line["quantity"] %></td>
            <td class="commerce-invoice__num"><%= @invoice.formatted(line["unit_price_cents"]) %></td>
            <td class="commerce-invoice__num"><%= @invoice.formatted(line["quantity"].to_i * line["unit_price_cents"].to_i) %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr><td colspan="3">Subtotal</td><td><%= @invoice.formatted(@invoice.subtotal_cents) %></td></tr>
        <% if @invoice.tax_cents.positive? %><tr><td colspan="3">Tax</td><td><%= @invoice.formatted(@invoice.tax_cents) %></td></tr><% end %>
        <% if @invoice.shipping_cents.positive? %><tr><td colspan="3">Shipping</td><td><%= @invoice.formatted(@invoice.shipping_cents) %></td></tr><% end %>
        <tr class="commerce-invoice__total">
          <td colspan="3">Total <span class="commerce-invoice__currency"><%= @invoice.currency %></span></td>
          <td><%= @invoice.formatted(@invoice.total_cents) %></td>
        </tr>
      </tfoot>
    </table>
  </div>

  <% if @invoice.payment_link.present? && !@invoice.paid? && !@invoice.void? %>
    <div class="commerce-invoice__screen-only">
      <div class="commerce-invoice__pay-row">
        <a class="btn btn--primary commerce-invoice__pay" href="<%= @invoice.payment_link %>" rel="noopener">Pay <%= @invoice.formatted(@invoice.total_cents) %></a>
      </div>
    </div>
  <% elsif @invoice.paid? %>
    <p class="notice notice--success commerce-invoice__paid">Paid<%= @invoice.paid_at ? " on #{@invoice.paid_at.to_date.to_fs(:long)}" : "" %>. Thank you.</p>
  <% end %>

  <% if @invoice.notes.present? %><p class="commerce-invoice__notes"><%= @invoice.notes %></p><% end %>
  <% if @invoice.terms.present? %><p class="commerce-invoice__terms"><%= @invoice.terms %></p><% end %>

  <footer class="commerce-invoice__footer">
    <span class="commerce-invoice__screen-only"><a href="javascript:print()" class="commerce-invoice__print">Print or save as PDF</a> · </span>
    Invoice <%= @invoice.number %> · <%= @business %>
  </footer>
</main>
