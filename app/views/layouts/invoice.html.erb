<!DOCTYPE html>
<%# The customer's hosted invoice: no admin around it, always the light
    theme (it's a document, and it prints), in the site's branding. %>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <title><%= content_for?(:title) ? yield(:title) : "Invoice" %></title>
    <%= app_stylesheet_tags %>
    <%= branding_stylesheet_tags %>
  </head>
  <body class="invoice-page bg-gray-50 text-gray-900">
    <%= yield %>
  </body>
</html>
