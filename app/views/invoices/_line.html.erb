<%# locals: (line:, currency:, key:) %>
<%# One invoice line, posted as invoice[line_items][<key>][…]. The schema
    editor's controller adds, removes and reorders the rows, drawn as its
    own (schemas.css). %>
<% name = "invoice[line_items][" + key + "]" %>
<li class="schema-field" data-schema-editor-target="row">
  <div class="schema-field__main">
    <label class="schema-field__control schema-field__control--grow commerce-line__description">
      <span class="schema-field__label">Description</span>
      <%= text_field_tag name + "[description]", line["description"], id: nil, placeholder: "What was sold",
            autocomplete: "off", data: { schema_editor_target: "name" } %>
    </label>
    <label class="schema-field__control commerce-line__sku">
      <span class="schema-field__label">SKU</span>
      <%= text_field_tag name + "[sku]", line["sku"], id: nil, class: "text-mono", autocomplete: "off" %>
    </label>
    <label class="schema-field__control commerce-line__quantity">
      <span class="schema-field__label">Qty</span>
      <%= number_field_tag name + "[quantity]", line["quantity"] || 1, id: nil, min: 1 %>
    </label>
    <label class="schema-field__control commerce-line__price">
      <span class="schema-field__label">Unit price</span>
      <%= text_field_tag name + "[unit_price]", money_input_value(line["unit_price_cents"], currency), id: nil,
            inputmode: "decimal", autocomplete: "off", placeholder: "0.00" %>
    </label>
    <div class="row row--2xs row--end">
      <button type="button" class="btn btn--plain btn--icon" title="Move up" data-action="schema-editor#moveUp">
        <%= icon_tag "arrow-up" %>
        <span class="visually-hidden">Move up</span>
      </button>
      <button type="button" class="btn btn--plain btn--icon schema-field__remove" title="Remove line" data-action="schema-editor#remove">
        <%= icon_tag "trash" %>
        <span class="visually-hidden">Remove line</span>
      </button>
    </div>
  </div>
</li>
