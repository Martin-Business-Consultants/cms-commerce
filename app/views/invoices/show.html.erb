<% @page_title = "Invoice " + @invoice.number %>
<%= parent_page "Invoices", invoices_path %>
<% can_write = Current.user.can?("invoices:write") %>
<% public_url = request.base_url + @invoice.public_path %>

<% content_for :page_actions do %>
  <% if can_write && !@invoice.paid? && !@invoice.void? %>
    <%= link_to "Edit", edit_invoice_path(@invoice), class: "btn" %>
  <% end %>
  <% if Current.user.can?("invoices:send") && @invoice.sendable? %>
    <% send_label = @invoice.sent? ? "Send again" : "Send to customer" %>
    <%= render "layouts/shared/confirm_dialog", label: send_label, title: send_label + "?",
          path: invoice_delivery_path(@invoice), button: "Send",
          message: "Emails " + @invoice.customer_email.to_s + " the invoice, its hosted page and the payment link." %>
  <% end %>
  <% if can_write && @invoice.sent? %>
    <%= render "layouts/shared/confirm_dialog", label: "Mark paid", title: "Mark " + @invoice.number + " paid?",
          path: invoice_payment_path(@invoice), message: "Do this once the money has arrived through your processor." %>
  <% end %>
  <% if can_write && (@invoice.sent? || @invoice.draft?) %>
    <%= render "layouts/shared/confirm_dialog", label: "Void", title: "Void " + @invoice.number + "?", negative: true,
          path: invoice_voiding_path(@invoice), message: "It stays on record, crossed out, and can no longer be paid." %>
  <% end %>
  <% if Current.user.can?("invoices:delete") && @invoice.draft? %>
    <%= render "layouts/shared/delete_dialog", name: "draft " + @invoice.number, path: invoice_path(@invoice) %>
  <% end %>
<% end %>
<%= render "layouts/shared/page_header", title: @page_title, description: @invoice.customer_name %>

<% if @invoice.draft? && !@invoice.sendable? %>
  <p class="notice notice--warning">It needs a customer email and at least one line before it can be sent.</p>
<% end %>

<div class="with-sidebar">
  <div>
    <section class="panel">
      <div class="commerce-box__header">
        <%= status_tag @invoice.status %>
        <span class="text-small text-muted">
          Issued <%= @invoice.issued_on ? l(@invoice.issued_on) : "—" %> · due <%= @invoice.due_on ? l(@invoice.due_on) : "—" %>
        </span>
      </div>

      <div class="commerce-box__scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>Description</th>
              <th>SKU</th>
              <th class="data-table__num">Qty</th>
              <th class="data-table__num">Unit</th>
              <th class="data-table__num">Amount</th>
            </tr>
          </thead>
          <tbody>
            <% @invoice.line_items.each_with_index do |line, index| %>
              <%# herb:key index %>
              <tr>
                <td><%= line["description"] %></td>
                <td><span class="text-mono text-small text-muted"><%= line["sku"] %></span></td>
                <td class="data-table__num"><%= line["quantity"] %></td>
                <td class="data-table__num"><%= @invoice.formatted(line["unit_price_cents"]) %></td>
                <td class="data-table__num"><%= invoice_line_total(@invoice, line) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="commerce-box__body">
        <dl class="commerce-totals">
          <div><dt>Subtotal</dt><dd><%= @invoice.formatted(@invoice.subtotal_cents) %></dd></div>
          <% if @invoice.tax_cents.to_i.nonzero? %>
            <div><dt>Tax</dt><dd><%= @invoice.formatted(@invoice.tax_cents) %></dd></div>
          <% end %>
          <% if @invoice.shipping_cents.to_i.nonzero? %>
            <div><dt>Shipping</dt><dd><%= @invoice.formatted(@invoice.shipping_cents) %></dd></div>
          <% end %>
          <div class="commerce-totals__grand"><dt>Total</dt><dd><%= @invoice.formatted(@invoice.total_cents) %></dd></div>
        </dl>

        <% if @invoice.notes.present? %>
          <div class="commerce-note">
            <h3 class="commerce-note__title">Notes</h3>
            <%= simple_format @invoice.notes %>
          </div>
        <% end %>
        <% if @invoice.terms.present? %>
          <div class="commerce-note">
            <h3 class="commerce-note__title">Terms</h3>
            <%= simple_format @invoice.terms, class: "commerce-note__small" %>
          </div>
        <% end %>
      </div>
    </section>
  </div>

  <div>
    <section class="panel">
      <h2 class="heading commerce-box__title">Bill to</h2>
      <div class="commerce-box__address">
        <p class="commerce-box__name"><%= @invoice.customer_name %></p>
        <% if @invoice.company.present? %><p><%= @invoice.company %></p><% end %>
        <% if @invoice.billing_address.present? %>
          <%= simple_format @invoice.billing_address, class: "text-muted" %>
        <% end %>
      </div>
      <dl class="commerce-facts">
        <div><dt>Email</dt><dd class="truncate"><%= @invoice.customer_email.present? ? mail_to(@invoice.customer_email, class: "link") : "—" %></dd></div>
        <div><dt>Phone</dt><dd><%= @invoice.customer_phone.presence || "—" %></dd></div>
      </dl>
    </section>

    <section class="panel">
      <h2 class="heading commerce-box__title">Getting paid</h2>
      <dl class="commerce-facts">
        <div>
          <dt>Payment link</dt>
          <dd class="truncate"><%= @invoice.payment_link.present? ? external_link(@invoice.payment_link) : "None yet — add one before sending." %></dd>
        </div>
        <div>
          <dt>Customer’s page</dt>
          <dd class="row">
            <%= link_to "Open", public_url, class: "link", target: "_blank", rel: "noopener" %>
            <button type="button" class="btn btn--sm" data-controller="copy-to-clipboard" data-copy-to-clipboard-content-value="<%= public_url %>" data-copy-to-clipboard-success-class="btn--success" data-action="copy-to-clipboard#copy">Copy link</button>
          </dd>
        </div>
        <% if @invoice.sent_at %><div><dt>Sent</dt><dd><%= l(@invoice.sent_at, format: :long) %></dd></div><% end %>
        <% if @invoice.paid_at %><div><dt>Paid</dt><dd><%= l(@invoice.paid_at, format: :long) %></dd></div><% end %>
        <% if @invoice.voided_at %><div><dt>Voided</dt><dd><%= l(@invoice.voided_at, format: :long) %></dd></div><% end %>
      </dl>
      <% if @invoice.quote_request %>
        <p class="panel__footer">From <%= link_to "quote request #" + @invoice.quote_request_id.to_s, quote_request_path(@invoice.quote_request), class: "link" %>.</p>
      <% end %>
    </section>
  </div>
</div>
