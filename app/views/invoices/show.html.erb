<% @page_title = "Invoice " + @invoice.number %>
<%= parent_page "Invoices", invoices_path %>
<% can_write = Current.user.can?("invoices:write") %>
<% public_url = request.base_url + @invoice.public_path %>

<% content_for :page_actions do %>
  <% if can_write && !@invoice.paid? && !@invoice.void? %>
    <%= link_to "Edit", edit_invoice_path(@invoice), class: ui(:button) %>
  <% end %>
  <% if Current.user.can?("invoices:send") && @invoice.sendable? %>
    <% send_label = @invoice.sent? ? "Send again" : "Send to customer" %>
    <%= render "layouts/shared/confirm_dialog", label: send_label, title: send_label + "?",
          path: invoice_delivery_path(@invoice), button: "Send",
          message: "Emails " + @invoice.customer_email.to_s + " the invoice, its hosted page and the payment link." %>
  <% end %>
  <% if can_write && @invoice.sent? %>
    <%= render "layouts/shared/confirm_dialog", label: "Mark paid", title: "Mark " + @invoice.number + " paid?",
          path: invoice_payment_path(@invoice), message: "Do this once the money has arrived through your processor." %>
  <% end %>
  <% if can_write && (@invoice.sent? || @invoice.draft?) %>
    <%= render "layouts/shared/confirm_dialog", label: "Void", title: "Void " + @invoice.number + "?", negative: true,
          path: invoice_voiding_path(@invoice), message: "It stays on record, crossed out, and can no longer be paid." %>
  <% end %>
  <% if Current.user.can?("invoices:delete") && @invoice.draft? %>
    <%= render "layouts/shared/delete_dialog", name: "draft " + @invoice.number, path: invoice_path(@invoice) %>
  <% end %>
<% end %>
<%= render "layouts/shared/page_header", title: @page_title, description: @invoice.customer_name %>

<% if @invoice.draft? && !@invoice.sendable? %>
  <p class="<%= ui(:notice, :yellow, "mb-4") %>">It needs a customer email and at least one line before it can be sent.</p>
<% end %>

<% facts_classes = "divide-y divide-gray-100 border-t border-gray-200 text-sm" %>
<% fact_classes = "flex items-baseline justify-between gap-4 px-5 py-2.5" %>
<% fact_term_classes = "shrink-0 text-gray-500" %>
<% fact_value_classes = "min-w-0 text-right text-gray-900" %>
<% total_classes = "flex items-baseline justify-between gap-4" %>
<div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-3">
  <section class="<%= ui(:panel, "lg:col-span-2") %>">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-200 px-5 py-3.5">
      <%= status_tag @invoice.status %>
      <span class="text-xs text-gray-500">
        Issued <%= @invoice.issued_on ? l(@invoice.issued_on) : "—" %> · due <%= @invoice.due_on ? l(@invoice.due_on) : "—" %>
      </span>
    </div>

    <div class="overflow-x-auto">
      <table class="data-table <%= ui(:table) %>">
        <thead>
          <tr>
            <th class="<%= ui(:th) %>">Description</th>
            <th class="<%= ui(:th) %>">SKU</th>
            <th class="<%= ui(:th, "text-right") %>">Qty</th>
            <th class="<%= ui(:th, "text-right") %>">Unit</th>
            <th class="<%= ui(:th, "text-right") %>">Amount</th>
          </tr>
        </thead>
        <tbody>
          <% @invoice.line_items.each_with_index do |line, index| %>
            <%# herb:key index %>
            <tr>
              <td class="<%= ui(:td) %>"><%= line["description"] %></td>
              <td class="<%= ui(:td) %>"><span class="font-mono text-xs text-gray-500"><%= line["sku"] %></span></td>
              <td class="<%= ui(:td, "text-right tabular-nums") %>"><%= line["quantity"] %></td>
              <td class="<%= ui(:td, "text-right tabular-nums") %>"><%= @invoice.formatted(line["unit_price_cents"]) %></td>
              <td class="<%= ui(:td, "text-right tabular-nums") %>"><%= invoice_line_total(@invoice, line) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="space-y-5 p-5">
      <dl class="ml-auto flex max-w-xs flex-col gap-1.5 text-sm tabular-nums">
        <div class="<%= total_classes %>"><dt class="text-gray-500">Subtotal</dt><dd class="text-gray-900"><%= @invoice.formatted(@invoice.subtotal_cents) %></dd></div>
        <% if @invoice.tax_cents.to_i.nonzero? %>
          <div class="<%= total_classes %>"><dt class="text-gray-500">Tax</dt><dd class="text-gray-900"><%= @invoice.formatted(@invoice.tax_cents) %></dd></div>
        <% end %>
        <% if @invoice.shipping_cents.to_i.nonzero? %>
          <div class="<%= total_classes %>"><dt class="text-gray-500">Shipping</dt><dd class="text-gray-900"><%= @invoice.formatted(@invoice.shipping_cents) %></dd></div>
        <% end %>
        <div class="<%= class_names(total_classes, "border-t border-gray-200 pt-2 font-semibold text-gray-900") %>"><dt>Total</dt><dd><%= @invoice.formatted(@invoice.total_cents) %></dd></div>
      </dl>

      <% if @invoice.notes.present? %>
        <div class="space-y-1 text-sm">
          <h3 class="font-medium text-gray-900">Notes</h3>
          <%= simple_format @invoice.notes, class: "text-gray-700" %>
        </div>
      <% end %>
      <% if @invoice.terms.present? %>
        <div class="space-y-1 text-sm">
          <h3 class="font-medium text-gray-900">Terms</h3>
          <%= simple_format @invoice.terms, class: "text-xs text-gray-500" %>
        </div>
      <% end %>
    </div>
  </section>

  <div class="flex flex-col gap-6">
    <section class="<%= ui(:panel) %>">
      <h2 class="<%= ui(:heading, "px-5 py-3.5") %>">Bill to</h2>
      <div class="space-y-1 px-5 pb-4 text-sm text-gray-700">
        <p class="font-medium text-gray-900"><%= @invoice.customer_name %></p>
        <% if @invoice.company.present? %><p><%= @invoice.company %></p><% end %>
        <% if @invoice.billing_address.present? %>
          <%= simple_format @invoice.billing_address, class: "text-gray-500" %>
        <% end %>
      </div>
      <dl class="<%= facts_classes %>">
        <div class="<%= fact_classes %>"><dt class="<%= fact_term_classes %>">Email</dt><dd class="<%= fact_value_classes %> truncate"><%= @invoice.customer_email.present? ? mail_to(@invoice.customer_email, class: ui(:link)) : "—" %></dd></div>
        <div class="<%= fact_classes %>"><dt class="<%= fact_term_classes %>">Phone</dt><dd class="<%= fact_value_classes %>"><%= @invoice.customer_phone.presence || "—" %></dd></div>
      </dl>
    </section>

    <section class="<%= ui(:panel) %>">
      <h2 class="<%= ui(:heading, "px-5 py-3.5") %>">Getting paid</h2>
      <dl class="<%= facts_classes %>">
        <div class="<%= fact_classes %>">
          <dt class="<%= fact_term_classes %>">Payment link</dt>
          <dd class="<%= fact_value_classes %> truncate"><%= @invoice.payment_link.present? ? external_link(@invoice.payment_link) : "None yet — add one before sending." %></dd>
        </div>
        <div class="<%= fact_classes %>">
          <dt class="<%= fact_term_classes %>">Customer’s page</dt>
          <dd class="flex items-center gap-2">
            <%= link_to "Open", public_url, class: ui(:link), target: "_blank", rel: "noopener" %>
            <button type="button" class="<%= ui(:button, :small) %>" data-controller="copy-to-clipboard" data-copy-to-clipboard-content-value="<%= public_url %>" data-copy-to-clipboard-success-class="btn--success" data-action="copy-to-clipboard#copy">Copy link</button>
          </dd>
        </div>
        <% if @invoice.sent_at %><div class="<%= fact_classes %>"><dt class="<%= fact_term_classes %>">Sent</dt><dd class="<%= fact_value_classes %>"><%= l(@invoice.sent_at, format: :long) %></dd></div><% end %>
        <% if @invoice.paid_at %><div class="<%= fact_classes %>"><dt class="<%= fact_term_classes %>">Paid</dt><dd class="<%= fact_value_classes %>"><%= l(@invoice.paid_at, format: :long) %></dd></div><% end %>
        <% if @invoice.voided_at %><div class="<%= fact_classes %>"><dt class="<%= fact_term_classes %>">Voided</dt><dd class="<%= fact_value_classes %>"><%= l(@invoice.voided_at, format: :long) %></dd></div><% end %>
      </dl>
      <% if @invoice.quote_request %>
        <p class="rounded-b-xl border-t border-gray-200 bg-gray-50 px-5 py-2.5 text-xs text-gray-500">From <%= link_to "quote request #" + @invoice.quote_request_id.to_s, quote_request_path(@invoice.quote_request), class: ui(:link) %>.</p>
      <% end %>
    </section>
  </div>
</div>
