<% @page_title = "Invoices" %>

<% content_for :page_actions do %>
  <% if Current.user.can?("invoices:write") %>
    <%= render "layouts/shared/new_link", text: "New invoice", path: new_invoice_path %>
  <% end %>
<% end %>
<%= render "layouts/shared/page_header", title: @page_title, description: "What the shop has billed, newest first." %>

<%= render "layouts/shared/status_links", param: :status, current: @status.to_s, options: commerce_status_links(Invoice::STATUSES, @counts) %>

<div class="mb-3 flex flex-wrap items-center justify-end gap-3">
  <%= render "layouts/shared/list_search", placeholder: "Search invoices…" %>
</div>

<section class="<%= ui(:panel, "overflow-x-auto") %>">
  <table class="data-table <%= ui(:table) %>" data-controller="pagination" data-pagination-paginate-on-intersection-value="true" data-pagination-discard-frame-value="true">
    <thead>
      <tr>
        <th class="<%= ui(:th) %>">Number</th>
        <th class="<%= ui(:th) %>">Customer</th>
        <th class="<%= ui(:th) %>">Status</th>
        <th class="<%= ui(:th, "text-right") %>">Total</th>
        <th class="<%= ui(:th) %>">Due</th>
        <th class="<%= ui(:th) %>">Created</th>
      </tr>
    </thead>
    <tbody id="<%= pagination_frame_id_for(:invoice_rows, @page.number) %>">
      <% @invoices.each do |invoice| %>
        <%# herb:key invoice.id %>
        <tr id="<%= dom_id(invoice) %>" class="hover:bg-gray-50" data-filter-target="item">
          <td class="<%= ui(:td) %>"><%= link_to invoice.number, invoice_path(invoice), class: "whitespace-nowrap font-mono font-medium text-gray-900 hover:underline" %></td>
          <td class="<%= ui(:td) %>">
            <%= invoice.customer_name %>
            <div class="text-xs text-gray-500"><%= [invoice.company, invoice.customer_email].compact_blank.join(" · ") %></div>
          </td>
          <td class="<%= ui(:td) %>"><%= status_tag invoice.status %></td>
          <td class="<%= ui(:td, "text-right tabular-nums") %>"><%= invoice.formatted(invoice.total_cents) %></td>
          <td class="<%= ui(:td) %>"><span class="whitespace-nowrap text-xs text-gray-500"><%= invoice.due_on ? l(invoice.due_on) : "—" %></span></td>
          <td class="<%= ui(:td) %>"><span class="whitespace-nowrap text-xs text-gray-500"><%= time_ago_tag invoice.created_at %></span></td>
        </tr>
      <% end %>
      <%= table_next_page_row :invoice_rows, @page, columns: 6 %>
      <%= table_empty_row(@status ? "No #{@status} invoices." : "No invoices yet. Draft one from a quote request, or start a blank one.", columns: 6, link: (["Show all", invoices_path] if @status)) if @invoices.none? %>
    </tbody>
  </table>
</section>
