<% @page_title = "Invoices" %>

<% content_for :page_actions do %>
  <% if Current.user.can?("invoices:write") %>
    <%= render "layouts/shared/new_link", text: "New invoice", path: new_invoice_path %>
  <% end %>
<% end %>
<%= render "layouts/shared/page_header", title: @page_title, description: "What the shop has billed, newest first." %>

<%= render "layouts/shared/status_links", param: :status, current: @status.to_s, options: commerce_status_links(Invoice::STATUSES, @counts) %>

<div class="cluster cluster--end cluster--md">
  <%= render "layouts/shared/list_search", placeholder: "Search invoices…" %>
</div>

<section class="panel panel--scroll">
  <table class="data-table" data-controller="pagination" data-pagination-paginate-on-intersection-value="true" data-pagination-discard-frame-value="true">
    <thead>
      <tr>
        <th>Number</th>
        <th>Customer</th>
        <th>Status</th>
        <th class="data-table__num">Total</th>
        <th>Due</th>
        <th>Created</th>
      </tr>
    </thead>
    <tbody id="<%= pagination_frame_id_for(:invoice_rows, @page.number) %>">
      <% @invoices.each do |invoice| %>
        <%# herb:key invoice.id %>
        <tr id="<%= dom_id(invoice) %>" data-filter-target="item">
          <td><%= link_to invoice.number, invoice_path(invoice), class: "title-link nowrap text-mono" %></td>
          <td>
            <%= invoice.customer_name %>
            <div class="text-small text-muted"><%= [invoice.company, invoice.customer_email].compact_blank.join(" · ") %></div>
          </td>
          <td><%= status_tag invoice.status %></td>
          <td class="data-table__num"><%= invoice.formatted(invoice.total_cents) %></td>
          <td><span class="nowrap text-small text-muted"><%= invoice.due_on ? l(invoice.due_on) : "—" %></span></td>
          <td><span class="nowrap text-small text-muted"><%= time_ago_tag invoice.created_at %></span></td>
        </tr>
      <% end %>
      <%= table_next_page_row :invoice_rows, @page, columns: 6 %>
      <%= table_empty_row(@status ? "No #{@status} invoices." : "No invoices yet. Draft one from a quote request, or start a blank one.", columns: 6, link: (["Show all", invoices_path] if @status)) if @invoices.none? %>
    </tbody>
  </table>
</section>
