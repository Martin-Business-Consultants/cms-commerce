<% @page_title = "Quote request #" + @quote.id.to_s %>
<%= parent_page "Quote requests", quote_requests_path %>
<% can_write = Current.user.can?("quotes:write") %>

<% content_for :page_actions do %>
  <% if Current.user.can?("invoices:write") %>
    <%= link_to "Draft an invoice", new_invoice_path(quote_request_id: @quote.id), class: "btn" %>
  <% end %>
  <% if Current.user.can?("quotes:delete") %>
    <%= render "layouts/shared/delete_dialog", name: "quote request #" + @quote.id.to_s, path: quote_request_path(@quote),
          message: "Invoices drafted from it are kept. This can’t be undone." %>
  <% end %>
<% end %>
<%= render "layouts/shared/page_header", title: @quote.customer_name, description: @page_title + " · " + @quote.source + " · received " + l(@quote.created_at, format: :long) %>

<div class="with-sidebar">
  <div>
    <section class="panel">
      <h2 class="heading commerce-box__header">Asking about</h2>
      <% if @quote.items.any? %>
        <div class="commerce-box__scroll">
          <table class="data-table">
            <thead>
              <tr>
                <th>Item</th>
                <th>SKU</th>
                <th class="data-table__num">Qty</th>
                <th class="data-table__num">Listed at</th>
              </tr>
            </thead>
            <tbody>
              <% @quote.items.each_with_index do |item, index| %>
                <%# herb:key index %>
                <tr>
                  <td><%= external_link item["url"], item["title"] %></td>
                  <td><span class="text-mono text-small text-muted"><%= item["sku"] %></span></td>
                  <td class="data-table__num"><%= item["quantity"] %></td>
                  <td class="data-table__num"><%= item["unit_price"] %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="commerce-box__empty">No items — just the message.</p>
      <% end %>
      <% if @quote.message.present? %>
        <div class="commerce-box__body">
          <div class="commerce-note">
            <h3 class="commerce-note__title">Message</h3>
            <%= simple_format @quote.message %>
          </div>
        </div>
      <% end %>
    </section>

    <section class="panel">
      <h2 class="heading commerce-box__header">Working it</h2>
      <div class="commerce-box__body">
        <%= render "layouts/shared/errors", record: @quote %>
        <%= form_with model: @quote, scope: :quote, url: quote_request_path(@quote), method: :patch do |form| %>
          <%= tag.fieldset class: "fields", disabled: !can_write do %>
            <label class="field">
              <span class="label">Status</span>
              <%= form.select :status, QuoteRequest::STATUSES.map { [it.humanize, it] }, {}, class: "measure--sm" %>
            </label>
            <label class="field">
              <span class="label">Notes</span>
              <%= form.text_area :notes, rows: 4, placeholder: "What was quoted, when you called back…" %>
            </label>
            <details>
              <summary class="btn btn--sm">Edit the contact details</summary>
              <div class="disclosure__body grid grid--2">
                <label class="field"><span class="label">Name</span><%= form.text_field :customer_name, required: true %></label>
                <label class="field"><span class="label">Company</span><%= form.text_field :company %></label>
                <label class="field"><span class="label">Email</span><%= form.email_field :customer_email %></label>
                <label class="field"><span class="label">Phone</span><%= form.telephone_field :customer_phone %></label>
              </div>
            </details>
            <% if can_write %>
              <div><button type="submit" class="btn btn--primary">Save</button></div>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </section>
  </div>

  <div>
    <section class="panel">
      <h2 class="heading commerce-box__title">Contact</h2>
      <dl class="commerce-facts">
        <div><dt>Email</dt><dd class="truncate"><%= @quote.customer_email.present? ? mail_to(@quote.customer_email, class: "link") : "—" %></dd></div>
        <div><dt>Phone</dt><dd><%= @quote.customer_phone.present? ? link_to(@quote.customer_phone, "tel:" + @quote.customer_phone, class: "link") : "—" %></dd></div>
        <div><dt>Company</dt><dd><%= @quote.company.presence || "—" %></dd></div>
        <div><dt>From page</dt><dd class="truncate"><%= @quote.page_url.present? ? external_link(@quote.page_url) : "—" %></dd></div>
        <div><dt>IP</dt><dd class="text-mono text-small"><%= @quote.ip.presence || "—" %></dd></div>
      </dl>
    </section>

    <section class="panel">
      <h2 class="heading commerce-box__title">Invoices</h2>
      <% if @invoices.any? %>
        <ul class="commerce-facts">
          <% @invoices.each do |invoice| %>
            <%# herb:key invoice.id %>
            <li>
              <%= link_to invoice.number, invoice_path(invoice), class: "link text-mono" %>
              <span class="text-tabular text-body"><%= invoice.formatted(invoice.total_cents) %></span>
              <%= status_tag invoice.status %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="commerce-box__empty">None yet.</p>
      <% end %>
    </section>
  </div>
</div>
