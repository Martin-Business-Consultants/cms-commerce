<% @page_title = "Commerce" %>
<% can_write = Current.user.can?("invoices:write") %>

<%= render "layouts/shared/page_header", title: "Commerce" %>
<% content_for :settings_aside do %>
  <%= render "settings/save_box", form: "settings_form", capability: "invoices:write" %>
<% end %>

<%= form_with url: settings_commerce_path, id: "settings_form", method: :patch, scope: :settings do |form| %>
  <%= tag.fieldset class: "space-y-6", disabled: !can_write do %>
    <section class="<%= ui(:panel, "space-y-5 p-6") %>">
      <div class="space-y-1">
        <h2 class="<%= ui(:heading) %>">Quote requests</h2>
        <p class="text-sm text-gray-500">The site’s “Request a quote” button posts to <code class="font-mono"><%= @quote_endpoint %></code>. Requests land under Commerce › Quote requests, and these people are emailed.</p>
      </div>
      <%= settings_field "Notify", hint: "Comma-separated. Blank means nobody is emailed; the inbox still fills." do %>
        <%= form.text_field :notification_recipients, value: @settings["notification_recipients"], placeholder: "sales@example.com, owner@example.com", class: "w-full" %>
      <% end %>
      <%= settings_field "Thank-you message", hint: "Returned to the site after a successful request, for the form to show." do %>
        <%= form.text_area :success_message, value: @settings["success_message"], rows: 2, placeholder: "Got it. We'll call you with a price within one business day.", class: "w-full" %>
      <% end %>
    </section>

    <section class="<%= ui(:panel, "space-y-5 p-6") %>">
      <div class="space-y-1">
        <h2 class="<%= ui(:heading) %>">Sender</h2>
        <p class="text-sm text-gray-500">How quote notifications and invoices are signed. The envelope address is the platform’s; these set the display name and reply-to.</p>
      </div>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <%= settings_field "From name" do %>
          <%= form.text_field :from_name, value: @settings["from_name"], placeholder: "Discount Bakery Equipment", class: "w-full" %>
        <% end %>
        <%= settings_field "Reply-to", hint: "Where a customer’s reply to an invoice goes." do %>
          <%= form.email_field :reply_to, value: @settings["reply_to"], placeholder: "sales@example.com", class: "w-full" %>
        <% end %>
      </div>
    </section>

    <section class="<%= ui(:panel, "space-y-5 p-6") %>">
      <div class="space-y-1">
        <h2 class="<%= ui(:heading) %>">Invoices</h2>
        <p class="text-sm text-gray-500">Printed on every invoice and its hosted page.</p>
      </div>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <%= settings_field "Business name" do %>
          <%= form.text_field :business_name, value: @settings["business_name"], class: "w-full" %>
        <% end %>
        <%= settings_field "Phone" do %>
          <%= form.telephone_field :business_phone, value: @settings["business_phone"], class: "w-full" %>
        <% end %>
      </div>
      <%= settings_field "Address" do %>
        <%= form.text_area :business_address, value: @settings["business_address"], rows: 2, class: "w-full" %>
      <% end %>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <%= settings_field "Number prefix", hint: "Next: " + @next_number.to_s do %>
          <%= form.text_field :invoice_prefix, value: @settings["invoice_prefix"], placeholder: "INV", class: "w-full" %>
        <% end %>
        <%= settings_field "Start numbering at", hint: "Only raises the sequence; never reuses a number." do %>
          <%= form.number_field :invoice_next_number, value: @settings["invoice_next_number"], placeholder: "1001", class: "w-full" %>
        <% end %>
        <%= settings_field "Currency" do %>
          <%= form.text_field :currency, value: @settings["currency"], placeholder: "USD", maxlength: 3, class: "w-full" %>
        <% end %>
        <%= settings_field "Due in (days)" do %>
          <%= form.number_field :due_days, value: @settings["due_days"], placeholder: "14", class: "w-full" %>
        <% end %>
      </div>
      <%= settings_field "Default terms", hint: "Prefilled on new invoices; editable per invoice." do %>
        <%= form.text_area :default_terms, value: @settings["default_terms"], rows: 3, placeholder: "Payment due on receipt. A 4% convenience fee applies to credit card payments.", class: "w-full" %>
      <% end %>
    </section>
  <% end %>
<% end %>
